# ==========================================
# 1. LaTeX 编译产生的临时文件
# ==========================================
*.aux
*.log
*.out
*.toc
*.lof
*.lot
*.fls
*.fdb_latexmk
*.synctex.gz
*.synctex(busy)
*.xdv
*.bbl
*.blg

# ==========================================
# 2. Python/OCR 脚本产生的临时文件
# ==========================================
__pycache__/
*.py[cod]
.ipynb_checkpoints/
tmp/
temp/
# 如果你让 DSH 把 PDF 页面切成了临时图片，也可以在这里忽略
rendered_pages/

# ==========================================
# 3. 原始大文件
# ==========================================
# 假设你的书籍都在各自的 input/ 目录下存放着几百页的原始扫描版 PDF
# 这种文件往往几十上百 MB，GitHub 单文件超 100MB 就传不上去了
**/input/*.pdf
**/input/*.png
**/input/*.jpg
# 最终交付物为各书项目根目录下的 main.pdf，必须提交；不要添加忽略 *.pdf 的规则
# 如需忽略其它中间 PDF，请只针对具体路径设置

# ==========================================
# 4. 操作系统或编辑器生成的垃圾文件
# ==========================================
# macOS
.DS_Store
# Windows
Thumbs.db
desktop.ini
# VS Code
.vscode/
# JetBrains (PyCharm/IntelliJ)
.idea/

# ==========================================
# 5. 其他
# ==========================================
# 有些环境的备份文件
*~
*.bak
